/* Only the app's public static assets are cached. Provider calls and data are excluded. */
const CACHE=__CACHE__,PREFIX=__PREFIX__,ASSETS=__ASSETS__,BASE=__BASE__,VERSION=__VERSION__;
self.addEventListener('install',event=>event.waitUntil((async()=>{
  const cache=await caches.open(CACHE);
  await cache.addAll(ASSETS.map(url=>new Request(url,{cache:'reload'})));
  await self.skipWaiting();
})()));
// New assets activate automatically. Open app documents choose a safe time to refresh.
// A fresh, uncached update page also recovers older releases with no update control.
self.addEventListener('message',event=>{
  if(!['TETHER_ACTIVATE_UPDATE','TETHER_FINISH_UPDATE'].includes(event.data?.type) || !event.source?.url)return;
  const source=new URL(event.source.url);
  if(source.origin!==self.location.origin || source.pathname!==BASE+'update.html')return;
  if(event.data.type==='TETHER_ACTIVATE_UPDATE'){event.waitUntil(self.skipWaiting());return}
  event.waitUntil((async()=>{
    const reply=event.ports?.[0];if(!reply)return;
    if(event.data.version!==VERSION){reply.postMessage({error:'The installed app version could not be verified. Try updating again.'});return}
    // The update page holds the chat queue lock and has checked saved requests.
    // Notify other tabs; each protects its own requests and unsaved editors.
    await self.clients.claim();let refreshed=0,failed=0;
    for(const client of await self.clients.matchAll({type:'window',includeUncontrolled:true})){
      if(client.id===event.source.id || !['top-level','auxiliary'].includes(client.frameType))continue;
      const url=new URL(client.url);
      if(url.origin!==self.location.origin || !['','index.html','conversation.html','board.html','snapshots.html'].some(path=>url.pathname===BASE+path))continue;
      client.postMessage({type:'TETHER_RELEASE_AVAILABLE',version:VERSION});refreshed++;
    }
    reply.postMessage({version:VERSION,refreshed,failed});
  })());
});
self.addEventListener('activate',event=>event.waitUntil((async()=>{
  for(const key of await caches.keys())if(key.startsWith(PREFIX)&&key!==CACHE)await caches.delete(key);
  await self.clients.claim();
  for(const client of await self.clients.matchAll({type:'window'}))client.postMessage({type:'TETHER_RELEASE_AVAILABLE',version:VERSION});
})()));
self.addEventListener('fetch',event=>{
  const url=new URL(event.request.url);if(event.request.method!=='GET'||url.origin!==self.location.origin||!url.pathname.startsWith(BASE))return;
  const path=url.pathname===BASE?BASE+'index.html':url.pathname;
  if(path===BASE+'update.html')return;
  if(!ASSETS.includes(path))return;
  event.respondWith((async()=>{
    // Online requests get current files; the installed bundle is an offline fallback.
    try{const response=await fetch(new Request(event.request,{cache:'no-store'}));if(response.ok)return response}catch(_){}
    const cached=await (await caches.open(CACHE)).match(path);
    return cached||Response.error();
  })());
});
self.addEventListener('notificationclick',event=>{
  event.notification.close();const target=new URL(event.notification.data?.url||BASE,self.location.origin);
  if(target.origin!==self.location.origin||!target.pathname.startsWith(BASE))return;
  event.waitUntil(self.clients.openWindow(target.href));
});
